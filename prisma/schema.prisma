generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nama      String
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pemesanans         Pemesanan[] @relation("PemesananUser")
  approvalsApprover1 Pemesanan[] @relation("Approver1")
  approvalsApprover2 Pemesanan[] @relation("Approver2")
  driverPemesanans   Pemesanan[] @relation("Driver")
  logs               LogAktivitas[]
}

model Vehicle {
  id        String   @id @default(uuid())
  nama      String
  plat      String   @unique
  tipe      String   @default("angkutan_orang")
  kepemilikan String @default("milik")
  status    String   @default("aman")
  kilometer Int      @default(0)

  kmPerLiter         Float    @default(10)
  serviceIntervalKm  Int      @default(10000)
  oilChangeIntervalKm Int     @default(5000)
  lastServiceKm      Int?
  lastOilChangeKm    Int?
  lastService        DateTime?
  lastOilChange      DateTime?
  lastFuelRefill     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceLogs VehicleServiceLog[]
  pemesanans  Pemesanan[]
}

model VehicleServiceLog {
  id          String   @id @default(uuid())
  vehicleId   String
  tipe        String
  tanggal     DateTime
  kilometer   Int
  deskripsi   String?
  biaya       Float?
  createdAt   DateTime @default(now())

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Pemesanan {
  id              String    @id @default(uuid())
  pemohonId       String
  driverId        String?
  vehicleId       String?
  approver1Id     String
  approver2Id     String

  namaPemesan     String
  departemen      String
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  tujuan          String
  jarakKm         Float?
  jumlahPenumpang Int
  keterangan      String?

  status          String    @default("pending_level_1")
  catatanApprover1 String?
  catatanApprover2 String?
  approvedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pemohon        User      @relation("PemesananUser", fields: [pemohonId], references: [id])
  driver         User?     @relation("Driver", fields: [driverId], references: [id])
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id])
  approver1      User      @relation("Approver1", fields: [approver1Id], references: [id])
  approver2      User      @relation("Approver2", fields: [approver2Id], references: [id])
  logs           LogAktivitas[]
}

model LogAktivitas {
  id          String   @id @default(uuid())
  userId      String
  pemesananId String?
  aksi        String
  detail      String
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  pemesanan   Pemesanan? @relation(fields: [pemesananId], references: [id])
}